{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn",
    "style": "off",
    "restriction": "off"
  },
  "rules": {
    "no-console": "warn",
    "no-debugger": "error",
    "no-empty": "warn",
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-explicit-any": "off",
    "@typescript-eslint/no-explicit-any": "off"
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".nuxt",
    ".output",
    "coverage",
    "apps/api/vendor",
    "apps/api/storage",
    "apps/api/bootstrap/cache"
  ],
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.spec.ts", "test/**/*.ts"],
      "rules": {
        "no-console": "off",
        "no-underscore-dangle": "off"
      }
    },
    {
      "files": ["**/scripts/**/*.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["apps/banner/src/**/*.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["apps/edge/src/**/*.ts"],
      "rules": {
        "no-await-in-loop": "off"
      }
    }
  ]
}
