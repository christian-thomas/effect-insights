{
  "name": "@tracewatch/types",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./banner": "./src/banner.ts",
    "./consent": "./src/consent.ts",
    "./domain": "./src/domain.ts",
    "./gcm": "./src/gcm.ts",
    "./scanner": "./src/scanner.ts",
    "./schemas/banner": "./src/schemas/banner.ts",
    "./schemas/consent": "./src/schemas/consent.ts",
    "./schemas/scanner": "./src/schemas/scanner.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "fix": "bun run format && bun run lint:fix",
    "build": "echo 'types package is source-only' && exit 0"
  },
  "dependencies": {
    "zod": "latest"
  },
  "devDependencies": {
    "typescript": "latest"
  }
}
