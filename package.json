{
  "name": "effectinsight",
  "version": "0.0.0",
  "private": true,
  "description": "Effect Digital Consent Management Platform — white-label CMP replacing CookieBot/CookieYes",
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  },
  "workspaces": [
    "apps/admin",
    "apps/api",
    "apps/banner",
    "apps/docs",
    "apps/edge",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "check": "turbo run check",
    "fix": "turbo run fix",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "turbo": "latest",
    "typescript": "latest"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "esbuild",
    "sharp",
    "unrs-resolver",
    "workerd"
  ]
}
