APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Sanctum SPA — Nuxt admin runs on 3001 in dev
SANCTUM_STATEFUL_DOMAINS=localhost:3001,localhost:3000
FRONTEND_URL=http://localhost:3001

# WebAuthn passkey ceremony origin whitelist. Dev-only: required so the
# admin SPA on http://localhost:3001 can register / authenticate passkeys
# (without it, web-auth/webauthn-lib rejects non-HTTPS origins outright).
# Leave empty in production — HTTPS origins satisfy the default check.
PASSKEY_ALLOWED_ORIGINS=http://localhost:3001

# Cloudflare API — banner config publish writes to KV
# Create a dev KV namespace via `wrangler kv namespace create effectinsight-dev`
# and an API token with KV Storage:Edit scope at https://dash.cloudflare.com/profile/api-tokens
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_KV_NAMESPACE_ID=
# D1 database backing the edge consent worker. Get the ID via
# `wrangler d1 list`. Used by the `consent-events:archive` nightly job.
CF_D1_DATABASE_ID=

# Shared secret the edge consent worker sends as X-Effect-Ingest-Secret when
# mirroring consent events from D1 to Laravel. Generate via `openssl rand -hex 32`.
CONSENT_INGEST_SECRET=

# Cloudflare scanner worker (apps/edge/src/scanner-worker.ts). The Laravel side
# POSTs URL lists here and gets back parsed cookies / scripts / iframes /
# network requests. SCANNER_WORKER_SECRET must match the SCANNER_SECRET set on
# the worker via `wrangler secret put SCANNER_SECRET`.
SCANNER_WORKER_URL=
SCANNER_WORKER_SECRET=
SCANNER_TIMEOUT_SECONDS=60

# HMAC-SHA-256 secret used to sign banner config payloads on publish.
# Same value must live on the edge config worker (`wrangler secret put
# BANNER_CONFIG_SIGNING_KEY`) or the worker refuses to serve.
# Generate with `openssl rand -hex 32`.
BANNER_CONFIG_SIGNING_KEY=

# HMAC-SHA-256 secret used to sign consent receipts exported via
# /api/consent-events/{event}/receipt and /api/consent-events/receipts/by-anonymous-id.
# Receipts are self-contained JSON; the signature lets regulators verify
# integrity offline. Kept separate from BANNER_CONFIG_SIGNING_KEY so the
# blast radius of rotation is bounded. Generate with `openssl rand -hex 32`.
CONSENT_RECEIPT_SIGNING_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=effect_cmp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Redis-backed queues, driven by Horizon. Tests override this to `sync`
# via phpunit.xml so jobs run inline without needing a queue worker.
QUEUE_CONNECTION=redis
# Horizon dashboard label — shown in /horizon and notifications. Useful
# when several Horizon instances run against the same Redis (e.g.
# staging vs production).
HORIZON_NAME=effectinsight-api

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare email transport (Laravel 13 native driver). Set
# MAIL_MAILER=cloudflare in production to use it. CLOUDFLARE_MAIL_API_KEY
# wants a Cloudflare API token scoped to Email Routing Send only — use a
# dedicated token rather than re-using CF_API_TOKEN. Falls back to
# CF_API_TOKEN if unset, so a single combined token still works for
# simpler setups.
CLOUDFLARE_MAIL_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
