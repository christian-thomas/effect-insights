{
  "name": "@effect-cmp/banner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev-all.ts",
    "dev:watch": "vite build --watch",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "serve:local": "bun run scripts/serve-fixtures.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "fix": "bun run format && bun run lint:fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@effect-cmp/types": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "latest",
    "happy-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
