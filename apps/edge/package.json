{
  "name": "@effect-cmp/edge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev-all.ts",
    "dev:config": "wrangler dev --config wrangler.config.toml --port 8787 --inspector-port 9229",
    "dev:consent": "wrangler dev --config wrangler.consent.toml --port 8788 --inspector-port 9230",
    "dev:scanner": "wrangler dev --config wrangler.scanner.toml --port 8789 --inspector-port 9231",
    "deploy:config": "wrangler deploy --config wrangler.config.toml",
    "deploy:consent": "wrangler deploy --config wrangler.consent.toml",
    "deploy:scanner": "wrangler deploy --config wrangler.scanner.toml",
    "db:migrate:consent": "wrangler d1 migrations apply effect-cmp-consent --remote --config wrangler.consent.toml",
    "db:migrate:consent:local": "wrangler d1 migrations apply effect-cmp-consent --local --config wrangler.consent.toml",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:wrangler": "bun run scripts/test-wrangler-dev-consent.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "fix": "bun run format && bun run lint:fix"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.1.0",
    "@effect-cmp/types": "workspace:*",
    "@hono/zod-validator": "latest",
    "axe-core": "^4.11.4",
    "hono": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "latest",
    "@cloudflare/workers-types": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
